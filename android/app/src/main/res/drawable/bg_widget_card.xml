<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:top="2dp"
        android:left="0dp"
        android:right="0dp"
        android:bottom="0dp">
        <shape android:shape="rectangle">
            <solid android:color="#140C4A6E" />
            <corners android:radius="16dp" />
        </shape>
    </item>

    <item
        android:top="0dp"
        android:left="0dp"
        android:right="0dp"
        android:bottom="2dp">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF" />
            <stroke
                android:width="1dp"
                android:color="#0F000000" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</layer-list>
